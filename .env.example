# Copy to .env and adjust. Every variable is optional; defaults live in src/pitwall/common/config.py.
# Never commit .env.

PITWALL_ENV=local
PITWALL_LOG_LEVEL=INFO
# json (machine-readable) or console (human-readable)
PITWALL_LOG_FORMAT=console
PITWALL_DATA_DIR=data

# Add a contact or repo URL so API operators can reach you.
PITWALL_USER_AGENT="PitWall/0.1 (unofficial F1 analytics project)"
PITWALL_HTTP_TIMEOUT_S=30
PITWALL_HTTP_MAX_RETRIES=5

# OpenF1 request budget (client side; the API sends no rate-limit headers)
PITWALL_OPENF1_BASE_URL=https://api.openf1.org/v1
PITWALL_OPENF1_REQUESTS_PER_SECOND=2
PITWALL_OPENF1_REQUESTS_PER_MINUTE=30
PITWALL_OPENF1_CACHE_ENABLED=true

# Object storage: SeaweedFS S3 locally (docker compose), R2 / S3 in the cloud.
# docker compose uses these same keys to create the local S3 account. Pick your own password.
PITWALL_S3_ENDPOINT_URL=http://localhost:9000
PITWALL_S3_BUCKET=pitwall-bronze
PITWALL_S3_ACCESS_KEY_ID=pitwall
PITWALL_S3_SECRET_ACCESS_KEY=change-me-locally
